FROM python:3.12-slim

WORKDIR /app
COPY . /app

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -e . pytest \
    && python -m pytest tests/test_runtime_http_service.py tests/test_capability_frontdoor.py -q

ENV PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["python", "-m", "valo_gateway.runtime_http_service"]
